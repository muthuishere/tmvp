---
// The hero picture. The glasses are the calm: close to the camera, tilted down,
// partly out of frame, out of focus. Through them, far away on the horizon of an
// empty runway at dusk, stand the four environments. Each is a machine that holds
// machines: a round glass dome that hovers, drifts and breathes over the runway,
// with a turning ring and its name riding under it, and
// inside it one small pod per system, always circulating and bumping. tmvp's
// calls come in from the foreground on both sides (sniper shots for single
// reads, rockets and salvos for the big ones), shrink with distance, and strike
// the systems. Sometimes it is a sweep, four in a row, the same system in dev1,
// dev2, staging and prod (one call, every env); between sweeps, single calls.
// The tempo builds from slow to fast, then it all starts again. A hit sends the pod flying around inside its dome,
// shoves its neighbours, throws embers that fall and bounce on the runway, and
// now and then a heavy round makes a much bigger fire. Nothing is destroyed: the
// pod it reached lights amber, lets go and sinks, and they pile up at the
// bottom of the dome.
//
// Three layers, back to front: the runway photograph, a canvas (systems and
// shots), the glasses photograph with see-through lens openings. So shots pass
// behind the frame. Both photographs are our own (public/hero/).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="tm-scene" role="img" aria-label="Seen through a pair of black glasses held tilted in the foreground: an empty runway at dusk, and far away on its horizon dev1, dev2, staging and prod, each a round glass dome with a small pod circulating inside for every system. Shots and rockets fly in from both sides and reach every system in turn; each one lights up amber.">
	<img class="world" src={`${base}/hero/runway.webp`} alt="" width="1800" height="792" decoding="async" fetchpriority="high" />
	<canvas data-tm-scene aria-hidden="true"></canvas>
	<div class="glasses">
		<img src={`${base}/hero/glasses.webp`} alt="" width="1800" height="1011" decoding="async" />
		<span class="emblem">T-mVp</span>
	</div>
</div>

<script>
	const VW = 1000, VH = 440, HY = 229; // HY: the horizon of the runway photograph
	// each environment: where its dome stands, its radius, how many systems live in it
	const ENVS = [
		{ name: 'DEV1', x: 392, r: 60, n: 8 },
		{ name: 'DEV2', x: 548, r: 60, n: 8 },
		{ name: 'STAGING', x: 836, r: 47, n: 6 },
		{ name: 'PROD', x: 938, r: 47, n: 6 },
	];
	const PH = 12; // pod height
	const CORE = ['logs', 'db', 'kafka', 'k8s']; // in every environment, so one sweep can reach it everywhere
	const SYSTEMS = ['cache', 'batch', 'api', 'queue', 'jobs', 'redis', 'grpc', 'mongo', 'nats', 'search', 'cron', 's3', 'auth'];
	const INK = '#f1ece3', AMBER = '#ff8a1f', WARM = '#ffd9a8';

	type P = { x: number; y: number };
	type Sys = { env: number; s: string; x: number; y: number; vx: number; vy: number; w: number; ph: number; on: boolean; lit: number; flash: number };
	type Shot = { at: number; kind: 'sniper' | 'rocket'; from: P; sys: Sys; heavy: boolean };
	type Rocket = { p0: P; p1: P; t: number; dur: number; sys: Sys; ph: number; heavy: boolean };
	type Tracer = { p0: P; t: number; sys: Sys; done: boolean };
	type Puff = { x: number; y: number; r: number; gr: number; vx: number; vy: number; t: number; max: number; a: number; dark: boolean };
	type Ember = { x: number; y: number; vx: number; vy: number; t: number; max: number; floor: number; r: number };
	type Boom = { x: number; y: number; t: number; R: number };
	type Fire = { x: number; y: number; t: number; max: number; size: number };

	function start(canvas: HTMLCanvasElement) {
		const ctx = canvas.getContext('2d');
		if (!ctx) return;
		const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const rnd = (a: number, b: number) => a + Math.random() * (b - a);
		// the dome stands on the runway, just this side of the horizon
		const cy = (e: (typeof ENVS)[number]) => HY + 13 - e.r;
		const shake = ENVS.map(() => ({ x: 0, y: 0, vx: 0, vy: 0 })); // the whole dome, knocked by hits
		const wob = ENVS.map(() => ({ a: 0, v: 0, dir: 0 })); // elastic squash along the line of the last hit
		// the dome is never still: it hovers, drifts and breathes, and hits push it around
		const dome = (i: number) => {
			const e = ENVS[i];
			return {
				x: e.x + Math.sin(clock * 0.55 + i * 2.1) * 5 + shake[i].x,
				y: cy(e) - 7 + Math.sin(clock * 0.95 + i * 1.3) * 4.5 + shake[i].y,
				R: e.r * (1 + 0.03 * Math.sin(clock * 1.5 + i * 0.8)),
			};
		};

		// one soft puff, drawn many times: smoke and fire that read as smoke and fire, not dots
		const sprite = (inner: string, outer: string) => {
			const c = document.createElement('canvas'); c.width = c.height = 64;
			const x = c.getContext('2d')!, g = x.createRadialGradient(32, 32, 0, 32, 32, 32);
			g.addColorStop(0, inner); g.addColorStop(0.55, outer); g.addColorStop(1, 'rgba(0,0,0,0)');
			x.fillStyle = g; x.fillRect(0, 0, 64, 64);
			return c;
		};
		const SMOKE = sprite('rgba(190,178,166,0.9)', 'rgba(120,110,102,0.35)');
		const EMBER = sprite('rgba(255,235,200,1)', 'rgba(255,140,50,0.45)');

		let sys: Sys[] = [], queue: Shot[] = [], rockets: Rocket[] = [], tracers: Tracer[] = [], puffs: Puff[] = [], embers: Ember[] = [], booms: Boom[] = [], fires: Fire[] = [];
		let raf = 0, last = 0, clock = 0, cycle = 0, endAt = 0, clearing = false;
		const glow = ENVS.map(() => 0); // how lit each mass is: rises as its systems are reached

		const build = () => {
			sys = [];
			ctx.font = '7.6px "Geist Mono Variable", ui-monospace, monospace';
			ENVS.forEach((e, env) => {
				const rest = [...SYSTEMS].sort(() => Math.random() - 0.5).slice(0, e.n - CORE.length);
				[...CORE, ...rest].forEach((s, i, all) => {
					const a = (i / all.length) * 6.28, d = e.r * 0.5;
					sys.push({ env, s, x: e.x + Math.cos(a) * d, y: cy(e) + Math.sin(a) * d, vx: rnd(-10, 10), vy: rnd(-10, 10), w: ctx.measureText(s).width + 15, ph: rnd(0, 6.28), on: false, lit: 0, flash: 0 });
				});
			});
		};

		// where shots come from: the foreground, off both edges, like someone standing beside us
		const origin = (kind: Shot['kind'], left: boolean): P =>
			kind === 'sniper'
				? { x: left ? rnd(-40, 60) : rnd(940, 1040), y: rnd(430, 470) }
				: { x: left ? -70 : 1070, y: rnd(-10, 170) };

		// What tmvp does, as a firing pattern. A sweep is one call across every
		// environment: four shots in a row, the same system in dev1, dev2, staging
		// and prod. Between sweeps, single calls pick off what is left. The tempo
		// builds as the run goes on, then it all starts again.
		const plan = () => {
			queue = [];
			let at = 0.4, left = true;
			const pending = new Set(sys);
			const shoot = (t: Sys, kind: Shot['kind'], heavy: boolean, gap: number) => {
				queue.push({ at, kind, from: origin(kind, left), sys: t, heavy });
				pending.delete(t); left = !left; at += gap;
			};
			const sweeps = [...CORE].sort(() => Math.random() - 0.5);
			const total = sys.length;
			while (pending.size) {
				const k = 1.15 - 0.7 * (1 - pending.size / total); // 1.15 down to 0.45: slow, then fast
				if (sweeps.length && Math.random() < 0.6) {
					const name = sweeps.pop()!, kind = Math.random() < 0.5 ? 'sniper' : 'rocket';
					for (const t of sys.filter((c) => c.s === name && pending.has(c))) shoot(t, kind, false, 0.13);
					at += 0.45 * k;
				} else {
					const rest = [...pending].filter((c) => !sweeps.includes(c.s));
					const pool = rest.length ? rest : [...pending];
					const n = Math.min(pool.length, 1 + ((Math.random() * 3) | 0));
					for (let i = 0; i < n; i++) {
						const t = pool.splice((Math.random() * pool.length) | 0, 1)[0];
						const kind = Math.random() < 0.4 ? 'sniper' : 'rocket';
						shoot(t, kind, kind === 'rocket' && Math.random() < 0.35, (kind === 'sniper' ? 0.26 : 0.38) * k);
					}
					at += 0.2 * k;
				}
			}
			endAt = at + 0.9 + 2.4;
			cycle = 0;
		};

		// rockets home on a moving target: the curve's end is wherever the system is now
		const bez = (r: Rocket, u: number): P => {
			const v = 1 - u;
			return { x: v * v * r.p0.x + 2 * v * u * r.p1.x + u * u * r.sys.x, y: v * v * r.p0.y + 2 * v * u * r.p1.y + u * u * r.sys.y };
		};
		const ease = (t: number) => 1 - Math.pow(1 - t, 2.2); // fast near us, slowing as it recedes
		const depth = (u: number) => 2.9 - 2.45 * u; // size near the camera vs. at the horizon

		const impact = (t: Sys, from: P, power: number) => {
			t.on = true; t.flash = 1;
			const dx = t.x - from.x, dy = t.y - from.y, d = Math.hypot(dx, dy) || 1;
			// the knock: the pod it hit flies off, its neighbours are shoved aside, the dome rattles
			for (const o of sys) {
				if (o.env !== t.env) continue;
				const ox = o.x - t.x, oy = o.y - t.y, od = Math.hypot(ox, oy);
				if (o === t) { o.vx += (dx / d) * 260 * power; o.vy += (dy / d) * 260 * power; }
				else if (od < 70) { const f = ((70 - od) / 70) * 190 * power; o.vx += (ox / (od || 1)) * f; o.vy += (oy / (od || 1)) * f; }
			}
			shake[t.env].vx += (dx / d) * 95 * power; shake[t.env].vy += (dy / d) * 60 * power;
			wob[t.env].dir = Math.atan2(dy, dx); wob[t.env].v -= 2.6 * power;
			booms.push({ x: t.x, y: t.y, t: 0, R: 8 + 13 * power });
			if (power >= 1) fires.push({ x: t.x, y: t.y, t: 0, max: power > 1.5 ? 1.7 : 0.7, size: power });
			// embers: thrown up and out, then they fall and bounce on the runway
			const n = Math.round(5 + 9 * power * power);
			for (let i = 0; i < n; i++) {
				const a = rnd(-Math.PI, 0), sp = rnd(30, 95) * (0.6 + power * 0.5);
				embers.push({ x: t.x, y: t.y, vx: Math.cos(a) * sp + (dx / d) * 25, vy: Math.sin(a) * sp, t: 0, max: rnd(0.9, 2.1), floor: HY + rnd(14, 58), r: rnd(0.7, 1.5) });
			}
		};

		const physics = (dt: number) => {
			for (const k of shake) {
				k.vx += (-70 * k.x - 4.5 * k.vx) * dt; k.vy += (-70 * k.y - 4.5 * k.vy) * dt; // a soft tether: it swings back slowly
				k.x += k.vx * dt; k.y += k.vy * dt;
			}
			for (const w of wob) { w.v += (-190 * w.a - 6 * w.v) * dt; w.a += w.v * dt; }
			for (const a of sys) {
				const e = ENVS[a.env], dm = dome(a.env), ex = dm.x, ey = dm.y;
				const rx = a.x - ex, ry = a.y - ey, rd = Math.hypot(rx, ry) || 1;
				// never still: a slow current round the dome (each dome turns its own way), plus a wander
				const spin = a.env % 2 ? -1 : 1;
				if (a.on) a.vy += 150 * dt; // reached: it lets go and sinks, and they pile up at the bottom
				else {
					a.vx += ((-ry / rd) * 16 * spin + Math.cos(clock * 1.3 + a.ph) * 12) * dt;
					a.vy += (((rx / rd) * 16 * spin) + Math.sin(clock * 1.7 + a.ph * 1.7) * 12 - 22) * dt; // unreached ones ride a little high
				}
				// pods bump: they are wider than tall, so compare in a squashed space
				for (const b of sys) {
					if (b === a || b.env !== a.env) continue;
					const dx = a.x - b.x, dy = (a.y - b.y) * 2.4, d = Math.hypot(dx, dy);
					const min = (a.w + b.w) / 2 + 2;
					if (d < min && d > 0.01) { const f = ((min - d) / min) * 900 * dt; a.vx += (dx / d) * f; a.vy += (dy / d) * f * 0.6; }
				}
				a.vx *= 1 - 1.4 * dt; a.vy *= 1 - 1.4 * dt;
				a.x += a.vx * dt; a.y += a.vy * dt;
				// the glass: bounce back in
				const dx = a.x - ex, dy = a.y - ey, d = Math.hypot(dx, dy), lim = dm.R - 4 - Math.abs(dx / (d || 1)) * a.w * 0.42 - Math.abs(dy / (d || 1)) * PH * 0.5;
				if (d > lim) {
					const nx = dx / d, ny = dy / d, vn = a.vx * nx + a.vy * ny;
					a.x = ex + nx * lim; a.y = ey + ny * lim;
					if (vn > 0) { const bounce = a.on ? 1.45 : 1.75; a.vx -= bounce * vn * nx; a.vy -= bounce * vn * ny; }
				}
				a.flash = Math.max(0, a.flash - dt * 3);
				a.lit += ((a.on ? 1 : 0) - a.lit) * Math.min(1, dt * (a.on ? 10 : 2.4));
			}
			ENVS.forEach((_, i) => {
				const mine = sys.filter((c) => c.env === i);
				const want = mine.filter((c) => c.on).length / mine.length;
				glow[i] += (want - glow[i]) * Math.min(1, dt * 4);
			});
		};

		const step = (dt: number) => {
			clock += dt; cycle += dt;
			while (queue.length && queue[0].at <= cycle) {
				const s = queue.shift()!;
				if (s.kind === 'sniper') tracers.push({ p0: s.from, t: 0, sys: s.sys, done: false });
				else rockets.push({ p0: s.from, p1: { x: (s.from.x + s.sys.x) / 2 + rnd(-40, 40), y: Math.min(s.from.y, s.sys.y) - rnd(20, 70) }, t: 0, dur: rnd(0.6, 0.8), sys: s.sys, ph: rnd(0, 6.28), heavy: s.heavy });
			}
			for (const r of rockets) {
				r.t += dt;
				const u = ease(Math.min(1, r.t / r.dur)), p = bez(r, u), s = depth(u) * (r.heavy ? 1.35 : 1);
				// the corkscrew: smoke left a little to either side of the flight line
				const w = Math.sin(r.t * 30 + r.ph) * 3.2 * s;
				for (let i = 0; i < 2; i++) puffs.push({ x: p.x + w * 0.5 + rnd(-1, 1), y: p.y + w, r: 1.8 * s, gr: 5 * s, vx: rnd(-2, 2), vy: rnd(-3, 0), t: 0, max: rnd(1.1, 1.9), a: 0.2, dark: true });
				if (r.t >= r.dur) impact(r.sys, r.p1, r.heavy ? 2 : 1);
			}
			rockets = rockets.filter((r) => r.t < r.dur);
			for (const t of tracers) {
				t.t += dt;
				if (!t.done && t.t >= 0.1) { t.done = true; impact(t.sys, t.p0, 0.7); }
			}
			tracers = tracers.filter((t) => t.t < 0.45);
			for (const f of fires) {
				f.t += dt;
				const k = 1 - f.t / f.max, n = f.size > 1.5 ? 3 : 1;
				// flames: hot puffs that climb, with smoke above them
				for (let i = 0; i < n; i++) if (Math.random() < dt * 60) puffs.push({ x: f.x + rnd(-4, 4) * f.size, y: f.y + rnd(-2, 3), r: 2.2 * f.size * k + 1, gr: 5, vx: rnd(-5, 5), vy: rnd(-34, -16), t: 0, max: rnd(0.3, 0.6), a: 0.6, dark: false });
				if (Math.random() < dt * 16) puffs.push({ x: f.x + rnd(-3, 3), y: f.y - 8, r: 2.5, gr: rnd(5, 9), vx: rnd(-2, 7), vy: rnd(-30, -16), t: 0, max: rnd(1.4, 2.4), a: 0.3, dark: true });
			}
			fires = fires.filter((f) => f.t < f.max);
			for (const p of puffs) { p.t += dt; p.x += p.vx * dt; p.y += p.vy * dt; p.r += p.gr * dt; }
			puffs = puffs.filter((p) => p.t < p.max);
			if (puffs.length > 900) puffs.splice(0, puffs.length - 900);
			for (const e of embers) {
				e.t += dt; e.vy += 190 * dt; e.vx *= 1 - 0.6 * dt;
				e.x += e.vx * dt; e.y += e.vy * dt;
				if (e.y > e.floor && e.vy > 0) { e.y = e.floor; e.vy *= -0.42; e.vx *= 0.6; }
			}
			embers = embers.filter((e) => e.t < e.max);
			for (const b of booms) b.t += dt;
			booms = booms.filter((b) => b.t < 0.5);
			physics(dt);
			// every system reached: hold, let them go quiet, go again
			if (cycle > endAt - 1 && !clearing) { clearing = true; sys.forEach((c) => (c.on = false)); }
			if (cycle > endAt) { clearing = false; plan(); }
		};

		const rr = (x: number, y: number, w: number, h: number, r: number) => { ctx.beginPath(); ctx.roundRect(x, y, w, h, r); };
		const world = () => {
			ctx.textBaseline = 'middle';
			ENVS.forEach((e, i) => {
				const g = glow[i], dm = dome(i), x = dm.x, y = dm.y, R = dm.R, lift = HY + 13 - (y + R);
				// its shadow, and the light it throws on the runway once it is reached
				ctx.save(); ctx.translate(x, HY + 15); ctx.scale(1 - lift * 0.012, 0.14);
				const pool = ctx.createRadialGradient(0, 0, 0, 0, 0, R * 1.5);
				pool.addColorStop(0, `rgba(${Math.round(255 * g)},${Math.round(140 * g)},${Math.round(40 * g)},${0.6 - g * 0.2})`); pool.addColorStop(1, 'rgba(0,0,0,0)');
				ctx.globalAlpha = 1; ctx.fillStyle = pool; ctx.beginPath(); ctx.arc(0, 0, R * 1.5, 0, 6.3); ctx.fill();
				ctx.restore();
				// squash and stretch along the line of the last hit
				ctx.save(); ctx.translate(x, y); ctx.rotate(wob[i].dir); ctx.scale(1 + wob[i].a * 0.16, 1 - wob[i].a * 0.16); ctx.rotate(-wob[i].dir); ctx.translate(-x, -y);
				// the glass: dark, a little see-through, warmer inside as it fills
				const glass = ctx.createRadialGradient(x - R * 0.3, y - R * 0.35, R * 0.1, x, y, R);
				glass.addColorStop(0, `rgba(${46 + Math.round(60 * g)},${42 + Math.round(22 * g)},${44},0.62)`);
				glass.addColorStop(1, 'rgba(10,10,13,0.78)');
				ctx.fillStyle = glass; ctx.beginPath(); ctx.arc(x, y, R, 0, 6.3); ctx.fill();
				// the rim, and the ring that never stops turning
				ctx.strokeStyle = 'rgba(210,205,198,0.5)'; ctx.lineWidth = 1.6; ctx.beginPath(); ctx.arc(x, y, R, 0, 6.3); ctx.stroke();
				ctx.save(); ctx.translate(x, y); ctx.rotate(clock * (i % 2 ? -0.5 : 0.5) * (1 + g));
				ctx.setLineDash([R * 0.5, R * 0.22]); ctx.strokeStyle = `rgba(255,138,31,${0.35 + g * 0.6})`; ctx.lineWidth = 1.4;
				ctx.beginPath(); ctx.arc(0, 0, R + 4, 0, 6.3); ctx.stroke();
				ctx.setLineDash([2, 5]); ctx.strokeStyle = 'rgba(255,255,255,0.22)'; ctx.lineWidth = 1; ctx.rotate(-clock * 1.1);
				ctx.beginPath(); ctx.arc(0, 0, R - 4, 0, 6.3); ctx.stroke();
				ctx.restore(); ctx.setLineDash([]);
				// a highlight where the sky catches the glass
				ctx.strokeStyle = 'rgba(255,255,255,0.28)'; ctx.lineWidth = 1.6; ctx.lineCap = 'round';
				ctx.beginPath(); ctx.arc(x, y, R - 8, Math.PI * 1.12, Math.PI * 1.42); ctx.stroke();
				ctx.restore();
			});
			// the pods: one small machine per system, a status light and a name
			ctx.font = '7.6px "Geist Mono Variable", ui-monospace, monospace';
			ctx.textAlign = 'left';
			for (const c of sys) {
				const x = c.x - c.w / 2, y = c.y - PH / 2;
				ctx.globalAlpha = 1;
				const face = ctx.createLinearGradient(0, y, 0, y + PH);
				face.addColorStop(0, '#45424a'); face.addColorStop(1, '#232227');
				ctx.fillStyle = face; ctx.beginPath(); ctx.roundRect(x, y, c.w, PH, PH / 2); ctx.fill();
				if (c.lit > 0.02) { ctx.globalAlpha = c.lit * 0.3; ctx.fillStyle = AMBER; ctx.beginPath(); ctx.roundRect(x, y, c.w, PH, PH / 2); ctx.fill(); ctx.globalAlpha = 1; }
				ctx.strokeStyle = c.lit > 0.5 ? 'rgba(255,138,31,0.9)' : 'rgba(255,255,255,0.2)'; ctx.lineWidth = 0.7;
				ctx.beginPath(); ctx.roundRect(x + 0.35, y + 0.35, c.w - 0.7, PH - 0.7, PH / 2); ctx.stroke();
				if (c.lit > 0.3) { const d = 10; ctx.globalAlpha = c.lit; ctx.drawImage(EMBER, x + 6 - d / 2, c.y - d / 2, d, d); ctx.globalAlpha = 1; }
				ctx.fillStyle = c.lit > 0.5 ? AMBER : '#7a766f'; ctx.beginPath(); ctx.arc(x + 6, c.y, 1.7, 0, 6.3); ctx.fill();
				ctx.fillStyle = c.lit > 0.5 ? '#ffe2bd' : INK; ctx.fillText(c.s, x + 10.5, c.y + 0.6);
				if (c.flash > 0) { ctx.globalAlpha = c.flash * 0.85; ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.roundRect(x, y, c.w, PH, PH / 2); ctx.fill(); }
			}
			// the name rides under each dome; it turns amber when every system in it has been reached
			ENVS.forEach((e, i) => {
				const mine = sys.filter((c) => c.env === i), hit = mine.filter((c) => c.on).length, full = hit === mine.length;
				const dm = dome(i), x = dm.x, y = dm.y + dm.R + 1, w = e.name.length * 6.4 + 20;
				ctx.globalAlpha = 1;
				ctx.fillStyle = '#121114'; ctx.beginPath(); ctx.roundRect(x - w / 2, y - 7, w, 15, 7.5); ctx.fill();
				ctx.strokeStyle = full ? AMBER : 'rgba(210,205,198,0.45)'; ctx.lineWidth = 1; ctx.beginPath(); ctx.roundRect(x - w / 2 + 0.5, y - 6.5, w - 1, 14, 7); ctx.stroke();
				ctx.font = '700 9.5px "Geist Mono Variable", ui-monospace, monospace';
				ctx.textAlign = 'center'; ctx.fillStyle = full ? AMBER : INK; ctx.fillText(e.name, x, y + 1);
			});
			ctx.globalAlpha = 1; ctx.textAlign = 'center';
		};

		const action = () => {
			for (const p of puffs) {
				const k = p.t / p.max, d = p.r * 2.6;
				ctx.globalAlpha = Math.min(1, p.a * (1 - k) * (1 - k) * 1.6);
				ctx.drawImage(p.dark ? SMOKE : EMBER, p.x - d / 2, p.y - d / 2, d, d);
			}
			for (const e of embers) {
				const k = e.t / e.max;
				ctx.globalAlpha = 1 - k * k;
				ctx.fillStyle = k < 0.35 ? WARM : AMBER;
				ctx.beginPath(); ctx.arc(e.x, e.y, e.r, 0, 6.3); ctx.fill();
			}
			ctx.lineCap = 'round';
			for (const t of tracers) {
				const u = Math.min(1, t.t / 0.1), fade = t.t < 0.1 ? 1 : 1 - (t.t - 0.1) / 0.35;
				const hx = t.p0.x + (t.sys.x - t.p0.x) * u, hy = t.p0.y + (t.sys.y - t.p0.y) * u;
				const g = ctx.createLinearGradient(t.p0.x, t.p0.y, hx, hy);
				g.addColorStop(0, 'rgba(255,217,168,0)'); g.addColorStop(1, 'rgba(255,240,215,0.95)');
				ctx.globalAlpha = fade; ctx.strokeStyle = g; ctx.lineWidth = 1.1;
				ctx.beginPath(); ctx.moveTo(t.p0.x, t.p0.y); ctx.lineTo(hx, hy); ctx.stroke();
			}
			for (const r of rockets) {
				const u = ease(Math.min(1, r.t / r.dur)), p = bez(r, u), q = bez(r, Math.max(0, u - 0.09)), s = depth(u) * (r.heavy ? 1.35 : 1);
				// the burn: a hot streak behind it
				const g = ctx.createLinearGradient(q.x, q.y, p.x, p.y);
				g.addColorStop(0, 'rgba(255,138,31,0)'); g.addColorStop(0.6, 'rgba(255,138,31,0.85)'); g.addColorStop(1, 'rgba(255,240,215,1)');
				ctx.globalAlpha = 1; ctx.strokeStyle = g; ctx.lineWidth = 2.1 * s;
				ctx.beginPath(); ctx.moveTo(q.x, q.y); ctx.lineTo(p.x, p.y); ctx.stroke();
				const d = 20 * s;
				ctx.drawImage(EMBER, p.x - d / 2, p.y - d / 2, d, d);
				const n = bez(r, Math.min(1, u + 0.01));
				ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(Math.atan2(n.y - p.y, n.x - p.x)); ctx.scale(s, s);
				ctx.fillStyle = '#f4f1ec';
				ctx.beginPath(); ctx.moveTo(-5, -1.3); ctx.lineTo(2.5, -1.3); ctx.quadraticCurveTo(6, -0.8, 7, 0); ctx.quadraticCurveTo(6, 0.8, 2.5, 1.3); ctx.lineTo(-5, 1.3); ctx.closePath(); ctx.fill();
				ctx.fillStyle = AMBER;
				ctx.beginPath(); ctx.moveTo(-5, 0); ctx.lineTo(-7.5, -3); ctx.lineTo(-2.5, -1.3); ctx.lineTo(-2.5, 1.3); ctx.lineTo(-7.5, 3); ctx.closePath(); ctx.fill();
				ctx.restore();
			}
			for (const b of booms) {
				const k = b.t / 0.5, R = b.R * (0.4 + k * 1.1), d = R * 2.4;
				ctx.globalAlpha = (1 - k) * (1 - k);
				ctx.drawImage(EMBER, b.x - d / 2, b.y - d / 2, d, d);
				ctx.strokeStyle = WARM; ctx.lineWidth = 1; ctx.globalAlpha = (1 - k) * 0.5;
				ctx.beginPath(); ctx.arc(b.x, b.y, R * 1.5, 0, 6.3); ctx.stroke(); // the shock ring
			}
			ctx.globalAlpha = 1;
		};

		const draw = () => {
			ctx.clearRect(0, 0, VW, VH);
			world();
			action();
		};

		const setup = () => {
			const r = canvas.getBoundingClientRect();
			const dpr = Math.min(devicePixelRatio || 1, 2);
			canvas.width = Math.round(r.width * dpr);
			canvas.height = Math.round(r.height * dpr);
			const k = canvas.width / VW;
			ctx.setTransform(k, 0, 0, k, 0, 0);
		};
		const loop = (now: number) => {
			raf = requestAnimationFrame(loop);
			const dt = Math.min(0.05, (now - last) / 1000 || 0.016);
			last = now;
			step(dt);
			draw();
		};

		setup(); build(); plan();
		for (let i = 0; i < 120; i++) { clock += 0.033; physics(0.033); } // let the pods find their room before the first frame
		if (reduce) { sys.forEach((c) => { c.on = true; c.lit = 1; }); glow.fill(1); }
		draw();
		new ResizeObserver(() => { setup(); draw(); }).observe(canvas);
		document.fonts?.ready.then(() => draw());
		if (reduce) return;
		new IntersectionObserver(([e]) => {
			cancelAnimationFrame(raf);
			if (e.isIntersecting) { last = performance.now(); raf = requestAnimationFrame(loop); }
		}).observe(canvas);
	}

	document.querySelectorAll<HTMLCanvasElement>('canvas[data-tm-scene]').forEach(start);
</script>
