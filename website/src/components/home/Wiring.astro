---
// How a call travels: agent → tmvp (local server: policy, secrets, audit) → one
// env's systems. Amber dots are reads reaching every env; the red dot is a write
// verb sent as a read, stopped at the policy row. SMIL motion; hidden under
// prefers-reduced-motion (the wires and boxes alone still read correctly).
---

<figure class="tm-wiring not-content" aria-label="An agent calls tmvp; tmvp's local server applies policy, holds secrets and writes the audit log, then reaches dev, staging and prod. A write sent as a read stops at the policy row.">
	<svg viewBox="0 0 760 300" role="img">
		<g class="wires">
			<path id="tm-w-in" d="M128 150 H262" />
			<path id="tm-w-dev" d="M478 150 H520 V62 H600" />
			<path id="tm-w-stg" d="M478 150 H600" />
			<path id="tm-w-prd" d="M478 150 H520 V238 H600" />
			<path id="tm-w-blk" d="M128 150 H262 V112 H300" class="ghost" />
		</g>

		<g class="box agent">
			<rect x="18" y="116" width="110" height="68" />
			<text x="32" y="142" class="k">agent</text>
			<text x="32" y="164" class="s">claude · codex</text>
			<text x="32" y="176" class="s">or you</text>
		</g>

		<g class="box tmvp">
			<rect x="262" y="70" width="216" height="160" />
			<text x="278" y="94" class="k amber">tmvp</text>
			<text x="320" y="94" class="s">local server</text>
			<line x1="262" y1="106" x2="478" y2="106" />
			<text x="278" y="128" class="r">policy</text><text x="372" y="128" class="s">read-only · caps</text>
			<line x1="262" y1="140" x2="478" y2="140" class="faint" />
			<text x="278" y="162" class="r">secrets</text><text x="372" y="162" class="s">in memory only</text>
			<line x1="262" y1="174" x2="478" y2="174" class="faint" />
			<text x="278" y="196" class="r">audit</text><text x="372" y="196" class="s">intent · outcome</text>
			<text x="278" y="220" class="s">one grammar, every type</text>
		</g>

		<g class="box env">
			<rect x="600" y="40" width="142" height="44" />
			<text x="614" y="60" class="k">dev</text><text x="614" y="74" class="s">db · cluster · logs</text>
		</g>
		<g class="box env">
			<rect x="600" y="128" width="142" height="44" />
			<text x="614" y="148" class="k">staging</text><text x="614" y="162" class="s">db · cluster · logs</text>
		</g>
		<g class="box env prod">
			<rect x="600" y="216" width="142" height="44" />
			<text x="614" y="236" class="k">prod</text><text x="614" y="250" class="s">read-only by default</text>
		</g>

		<g class="dots">
			<circle r="3.5" class="d"><animateMotion dur="1.2s" repeatCount="indefinite" begin="0s"><mpath href="#tm-w-in" /></animateMotion></circle>
			<circle r="3.5" class="d"><animateMotion dur="1.6s" repeatCount="indefinite" begin="0.25s"><mpath href="#tm-w-dev" /></animateMotion></circle>
			<circle r="3.5" class="d"><animateMotion dur="1.1s" repeatCount="indefinite" begin="0.5s"><mpath href="#tm-w-stg" /></animateMotion></circle>
			<circle r="3.5" class="d"><animateMotion dur="1.6s" repeatCount="indefinite" begin="0.75s"><mpath href="#tm-w-prd" /></animateMotion></circle>
			<circle r="3.5" class="x">
				<animateMotion dur="2.6s" repeatCount="indefinite" keyPoints="0;1;1" keyTimes="0;0.55;1" calcMode="linear"><mpath href="#tm-w-blk" /></animateMotion>
				<animate attributeName="opacity" dur="2.6s" repeatCount="indefinite" values="1;1;0;0" keyTimes="0;0.55;0.7;1" />
			</circle>
		</g>
		<text x="300" y="60" class="s bad blk">update … → exit 3</text>
	</svg>
	<figcaption>
		<span><i class="sw a"></i>reads reach every env</span>
		<span><i class="sw r"></i>a write verb sent as a read stops at policy</span>
	</figcaption>
</figure>
