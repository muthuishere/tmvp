=== config.yaml
# tmvp config for reqsume — holds NO secret values, only $(command)s that fetch them.
# Fill every "$file(sec get REPLACE_ME_… --out ${out})" slot with your secret manager's command, e.g.
#   "$file(sec get NAME --out ${out})"  "$(op read op://Vault/item/field)"  "$(gcloud secrets versions access latest --secret=NAME)"
# and every REPLACE_ME field with the real host/namespace/URL. Then: tmvp --skill <dir> validate && tmvp --skill <dir> check
version: 1
product: reqsume
logging:
  sink: file
  path: ~/.tmvp/reqsume/logs
# asset roots searched in order (relative to this file); add folders from other repos, e.g. ../ops-repo/tmvp-assets
assets: [assets]
# plain values, reusable as ${vars.x}
vars: {}
# named $(command)s shared by all envs, used as ${secrets.x}
secrets: {}
envs:
  dev:
    type: dev
    destructive: true
    vars: {}
    secrets:
      # SECRET: kubeconfig file content for dev.cluster — replace with your secret manager's command (never a value)
      cluster_kubeconfig: "$file(sec get REPLACE_ME_REQSUME_DEV_CLUSTER_KUBECONFIG --out ${out})"
    systems:
      db:
        type: postgres
        read:
          # SECRET: read-only DSN (postgres://user:pass@host:port/db) for dev.db — replace with your secret manager's command (never a value)
          dsn: "$file(sec get REPLACE_ME_REQSUME_DEV_DB_RO --out ${out})"
        write:
          # SECRET: read-write DSN for dev.db — replace with your secret manager's command (never a value)
          dsn: "$file(sec get REPLACE_ME_REQSUME_DEV_DB_RW --out ${out})"
      cluster:
        type: k8s
        kubeconfig: "${file:secrets.cluster_kubeconfig}"
        context: REPLACE_ME # kube context name inside that kubeconfig
        namespace: default
      admin:
        type: web
        base_url: https://REPLACE_ME # app URL in dev
        users:
          ops:
            role: read
            user: REPLACE_ME
            # SECRET: login password of user ops for dev.admin — replace with your secret manager's command (never a value)
            password: "$file(sec get REPLACE_ME_REQSUME_DEV_ADMIN_OPS_PASSWORD --out ${out})"
  staging:
    type: staging
    destructive: false
    vars: {}
    secrets:
      # SECRET: kubeconfig file content for staging.cluster — replace with your secret manager's command (never a value)
      cluster_kubeconfig: "$file(sec get REPLACE_ME_REQSUME_STAGING_CLUSTER_KUBECONFIG --out ${out})"
    systems:
      db:
        type: postgres
        read:
          # SECRET: read-only DSN (postgres://user:pass@host:port/db) for staging.db — replace with your secret manager's command (never a value)
          dsn: "$file(sec get REPLACE_ME_REQSUME_STAGING_DB_RO --out ${out})"
        write:
          # SECRET: read-write DSN for staging.db — replace with your secret manager's command (never a value)
          dsn: "$file(sec get REPLACE_ME_REQSUME_STAGING_DB_RW --out ${out})"
      cluster:
        type: k8s
        kubeconfig: "${file:secrets.cluster_kubeconfig}"
        context: REPLACE_ME # kube context name inside that kubeconfig
        namespace: default
      admin:
        type: web
        base_url: https://REPLACE_ME # app URL in staging
        users:
          ops:
            role: read
            user: REPLACE_ME
            # SECRET: login password of user ops for staging.admin — replace with your secret manager's command (never a value)
            password: "$file(sec get REPLACE_ME_REQSUME_STAGING_ADMIN_OPS_PASSWORD --out ${out})"
  prod:
    type: prod
    destructive: false
    vars: {}
    secrets:
      # SECRET: kubeconfig file content for prod.cluster — replace with your secret manager's command (never a value)
      cluster_kubeconfig: "$file(sec get REPLACE_ME_REQSUME_PROD_CLUSTER_KUBECONFIG --out ${out})"
    systems:
      db:
        type: postgres
        read:
          # SECRET: read-only DSN (postgres://user:pass@host:port/db) for prod.db — replace with your secret manager's command (never a value)
          dsn: "$file(sec get REPLACE_ME_REQSUME_PROD_DB_RO --out ${out})"
        write:
          # SECRET: read-write DSN for prod.db — replace with your secret manager's command (never a value)
          dsn: "$file(sec get REPLACE_ME_REQSUME_PROD_DB_RW --out ${out})"
      cluster:
        type: k8s
        kubeconfig: "${file:secrets.cluster_kubeconfig}"
        context: REPLACE_ME # kube context name inside that kubeconfig
        namespace: default
      admin:
        type: web
        base_url: https://REPLACE_ME # app URL in prod
        users:
          ops:
            role: read
            user: REPLACE_ME
            # SECRET: login password of user ops for prod.admin — replace with your secret manager's command (never a value)
            password: "$file(sec get REPLACE_ME_REQSUME_PROD_ADMIN_OPS_PASSWORD --out ${out})"
